{% extends 'base.html.twig' %}

{% block title %}Details{% endblock %}

{% block body %}

<div class="book-detail-page">
    <div class="book-detail-card">
        <div class="book-detail-cover">

            {% if book.imageFilename %}

                <img
                    src="/uploads/books/{{ book.imageFilename }}"
                    alt="Couverture de {{ book.title }}"
                >

            {% else %}

                <div class="book-detail-cover-placeholder">
                    📖
                    <span>Aucune couverture</span>
                </div>

            {% endif %}

        </div>
        <div class="book-detail-content">
            <h1>{{ book.title }}</h1>
            <p class="book-detail-author">
                {{ book.author }}
            </p>
            <div class="book-detail-info">

                <div class="book-info-item">
                    <span class="info-label">Genre</span>
                    <span>{{ book.genre.name }}</span>
                </div>
                <div class="book-info-item">
                    <span class="info-label">Statut</span>
                    <span class="book-status
                        {% if book.status.value == 'À lire' %}
                            status-to-read
                        {% elseif book.status.value == 'En cours' %}
                            status-reading
                        {% elseif book.status.value == 'Terminé' %}
                            status-finished
                        {% endif %}
                    ">
                        {{ book.status.value }}
                    </span>
                </div>
                <div class="book-info-item">
                    <span class="info-label">Ajouté le</span>
                    <span>{{ book.createdAt|date('d/m/Y') }}</span>
                </div>
            </div>
            <div class="book-detail-actions">
                <a
                    href="{{ path('app_books') }}"
                    class="back-button">
                    ← Retour
                </a>
                <a
                    href="{{ path('app_book_edit', {id: book.id}) }}"
                    class="edit-button">
                      Modifier
                </a>
                <form
                    method="post"
                    action="{{ path('app_book_delete', {id: book.id}) }}"
                    onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce livre ?');">
                    <button
                        type="submit"
                        class="delete-button">
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}
