{% extends 'base.html.twig' %}

{% block title %}Hello BookShowController!{% endblock %}

{% block body %}
<h1>📖 {{ book.title }}</h1>

<p>Auteur : {{ book.author }}</p>

<p>Genre : {{ book.genre.name }}</p>

<p>Statut : {{ book.status.value }}</p>

<p>Ajouté le : {{ book.createdAt|date('d/m/Y') }}</p>

<a href="{{ path('app_books') }}">← Retour</a>

<a href="{{ path('app_book_edit', {id: book.id}) }}">✏️ Modifier</a>

<form method="post" action="{{ path('app_book_delete', {id: book.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce livre ?');">
    <button type="submit">🗑️ Supprimer</button>
</form>

{% endblock %}
