{% extends 'base.html.twig' %}

{% block title %}Ajouter un livre{% endblock %}

{% block body %}

<div class="book-form-page">
    <div class="book-form-card">
        <div class="book-form-header">
            <span class="book-form-icon">➕</span>
            <h1>Nouveau livre</h1>
        </div>
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="book-form-fields">
                {{ form_row(form.title) }}
                {{ form_row(form.author) }}
                {{ form_row(form.status) }}
                {{ form_row(form.genre) }}
                {{ form_rest(form) }}
            </div>
        {{ form_end(form) }}
        <a
            href="{{ path('app_books') }}"
            class="form-back-link">
            Retour
        </a>
    </div>
</div>

{% endblock %}